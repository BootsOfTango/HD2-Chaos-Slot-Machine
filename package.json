{
  "name": "helldivers-2-chaos-slot-machine",
  "version": "1.1.14",
  "description": "Desktop wrapper for Helldivers 2 Chaos Slot Machine.",
  "main": "electron/main.js",
  "private": true,
  "author": "Boots Of Tango",
  "license": "SEE LICENSE IN LICENSE.txt",
  "scripts": {
    "prestart": "npm run prepare:icons",
    "start": "electron .",
    "predev": "npm run prepare:icons",
    "dev": "electron . --dev",
    "prepare:icons": "node scripts/create_icon.js",
    "prebuild:win": "npm run validate:csp && npm run validate:catalog && npm run validate:assets && npm run validate:installer-licenses && npm run prepare:installer-shell && npm run prepare:icons",
    "prepare:installer-shell": "node scripts/prepare-installer-shell.js",
    "build:win": "electron-builder --config electron-builder.config.js --win zip nsis --x64",
    "test": "node --test && npm run validate:csp && npm run validate:catalog && npm run validate:assets",
    "test:electron": "node scripts/run-electron-smoke.js",
    "test:window": "node scripts/run-window-smoke.js",
    "test:desktop-safety": "node scripts/run-desktop-safety-smoke.js",
    "test:renderer-security": "node scripts/run-renderer-security-smoke.js",
    "test:local-protocol": "node scripts/run-local-protocol-smoke.js",
    "test:origin-startup": "node scripts/run-origin-startup-smoke.js",
    "test:save-health": "node scripts/run-save-health-smoke.js",
    "test:transfer": "node scripts/run-transfer-smoke.js",
    "validate:assets": "python scripts/validate_assets.py",
    "validate:catalog": "python scripts/validate_item_catalog.py",
    "validate:csp": "python scripts/renderer_csp.py",
    "verify:public-release": "node scripts/check-public-release.js",
    "inventory:distribution": "node scripts/audit-distribution.js --write",
    "verify:distribution-inventory": "node scripts/audit-distribution.js --check",
    "validate:installer-licenses": "node scripts/prepare-installer-licenses.js --check && node scripts/installer-component-policy.js",
    "release:win": "npm run build:win && python scripts/verify_win_zip.py",
    "release:win:signed": "node scripts/with_windows_signing_required.js npm run build:win && python scripts/verify_win_zip.py && pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/verify_windows_signature.ps1"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^2.1.8",
    "pngjs": "^7.0.0"
  }
}

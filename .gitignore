# Generated wiki assets (large/binary) are synced locally by script
assets/weapons/primaries/*
assets/weapons/sidearms/*
assets/weapons/throwables/*
assets/stratagems/support/*
assets/stratagems/orbital/*
assets/stratagems/eagle/*
assets/stratagems/defensive/*
assets/stratagems/backpack/*
assets/stratagems/exosuits/*

# Keep folder placeholders committed
!assets/weapons/primaries/.gitkeep
!assets/weapons/sidearms/.gitkeep
!assets/weapons/throwables/.gitkeep
!assets/weapons/primaries/*-wiki.*
!assets/weapons/sidearms/*-wiki.*
!assets/weapons/throwables/*-wiki.*
!assets/stratagems/support/.gitkeep
!assets/stratagems/orbital/.gitkeep
!assets/stratagems/eagle/.gitkeep
!assets/stratagems/defensive/.gitkeep
!assets/stratagems/backpack/.gitkeep
!assets/stratagems/exosuits/.gitkeep

# Mapping file is committed
!assets/item-images.json

# Node / Electron dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*


# Generated desktop icon outputs
/build/icon.png
/build/icon.ico

# Electron generated build output
/dist/
/release/
out/
*.blockmap
*.snap
*.AppImage
*.exe
*.msi
*.dmg

# Local test screenshots
/test-artifacts/
/.test-data/

# Local credentials/signing material must not enter commits or releases.
.env
.env.*
!.env.example
*.pfx
*.p12
*.key
*.pem

# Generated Python cache and local installer shortcut
__pycache__/
*.pyc
/Helldivers 2 Chaos Slot Machine.lnk
/Helldivers-2-Chaos-Slot-Machine-Setup-v*-win-x64.exe.sha256
